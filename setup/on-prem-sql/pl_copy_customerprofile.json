{
  "activities": [
    {
      "name": "CopyFromSQLToADLS",
      "type": "Copy",
      "typeProperties": {
        "source": {
          "type": "SqlServerSource",
          "sqlReaderQuery": "SELECT * FROM dbo.Data_customer"
        },
        "sink": {
          "type": "DelimitedTextSink",
          "storeSettings": {
            "type": "AzureBlobFSWriteSettings"
          },
          "formatSettings": {
            "type": "DelimitedTextWriteSettings",
            "quoteAllText": true,
            "fileExtension": ".csv"
          }
        },
        "enableStaging": false
      },
      "inputs": [
        {
          "referenceName": "ds_sqlserver_customerprofile",
          "type": "DatasetReference"
        }
      ],
      "outputs": [
        {
          "referenceName": "ds_adls_landing_customerprofile",
          "type": "DatasetReference"
        }
      ]
    }
  ]
}
